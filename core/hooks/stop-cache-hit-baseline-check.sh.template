#!/usr/bin/env bash
#
# CONDUCTOR universal hook template
# hook_id: stop-cache-hit-baseline-check
# trigger: stop
# action: Read current Claude Code session JSONL, compute cache-read token share, emit
#         a non-blocking diagnostic reminder when below baseline.
# compile_targets: claude
# fallback: rule-text-reminder
#
# Generated by adapters/<tool>/transform.sh.
#
# Enforces:
#   - meta-discipline.md token-economy section (cache hit baseline)
#
# Behavior:
#   1. Use the current hook payload transcript_path; never scan other projects.
#   2. Deduplicate usage snapshots and sum cache-read/write and uncached input.
#   3. If cache-read share < ${CONDUCTOR_CACHE_HIT_FLOOR_PERCENT}% AND total
#      effective input tokens >= ${CONDUCTOR_CACHE_TOTAL_FLOOR}, emit a
#      stderr reminder listing the 5 candidate anti-patterns.
#   4. exit 0 (non-blocking).
#
# Override (silence reminder, e.g. CI sessions):
#   ${CONDUCTOR_CACHE_SKIP_ENV}=1
#
# Skip conditions:
#   - Python 3 missing (reported explicitly)
#   - no session JSONL found
#   - session token volume below floor (too short to draw conclusions)
#   - skip env var set

set -u

# Placeholders filled by adapters/<tool>/transform.sh:
#   ${CONDUCTOR_CACHE_HIT_FLOOR_PERCENT}  — compatibility env; token-share floor (default 95)
#   ${CONDUCTOR_CACHE_TOTAL_FLOOR}        — minimum total tokens before report (default 5000)
#   ${CONDUCTOR_CACHE_SKIP_ENV}           — env var to silence (default CONDUCTOR_SKIP_CACHE_CHECK)
#   ${CONDUCTOR_ANTI_PATTERNS_PATH}       — relative path to anti-patterns doc

FLOOR_PCT="${CONDUCTOR_CACHE_HIT_FLOOR_PERCENT:-95}"
TOTAL_FLOOR="${CONDUCTOR_CACHE_TOTAL_FLOOR:-5000}"
SKIP_ENV_NAME="${CONDUCTOR_CACHE_SKIP_ENV:-CONDUCTOR_SKIP_CACHE_CHECK}"
ANTI_PATTERNS_DOC="${CONDUCTOR_ANTI_PATTERNS_PATH:-core/anti-patterns/README.md}"

# Honor user opt-out without inspecting payload.
SKIP_VAL="$(/usr/bin/printenv "$SKIP_ENV_NAME" 2>/dev/null || true)"
[ "$SKIP_VAL" = "1" ] && exit 0

PYTHON_BIN=""
for candidate in "${CONDUCTOR_PYTHON_BIN:-}" python3 python; do
  [ -n "$candidate" ] || continue
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import json,sys; raise SystemExit(0 if sys.version_info[0] == 3 else 1)' >/dev/null 2>&1; then
    PYTHON_BIN="$candidate"
    break
  fi
done
if [ -z "$PYTHON_BIN" ]; then
  printf '%s\n' '[CONDUCTOR hook] Python 3 is unavailable; cache-read token share was not evaluated.' >&2
  exit 0
fi

# Allow tests to inject a fixture directly.
FIXTURE="${CONDUCTOR_CACHE_TEST_FIXTURE:-}"
SESSION_PATH=""

if [ -n "$FIXTURE" ]; then
  [ -f "$FIXTURE" ] || exit 0
  SESSION_PATH="$FIXTURE"
else
  # Hook payload belongs to this session. A newest-global-file fallback could
  # inspect another project and adds O(all sessions) work to every Stop event.
  [ -t 0 ] && exit 0
  PAYLOAD="$(/usr/bin/head -c 65537)"
  SESSION_PATH="$(printf '%s' "$PAYLOAD" | "$PYTHON_BIN" -c 'import json,sys
raw=sys.stdin.read(65537)
if len(raw.encode()) > 65536: sys.exit(0)
try:
    obj=json.loads(raw)
    value=obj.get("transcript_path")
    if isinstance(value,str) and not any(c in value for c in "\n\r\0"): print(value)
except Exception: pass
' 2>/dev/null)"
  [ -n "$SESSION_PATH" ] && [ -f "$SESSION_PATH" ] || exit 0
fi

# Parse + decide. Python prints a single line: "<hit_rate> <total_eff>".
RESULT=$(SESSION="$SESSION_PATH" "$PYTHON_BIN" - <<'PYEOF' 2>/dev/null
import json, os, sys, stat
path = os.environ.get("SESSION", "")
total_input = 0
total_cache_read = 0
total_cache_write = 0
messages = {}
try:
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > 16 * 1024 * 1024:
        sys.exit(0)
    with open(path, "r", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                continue
            msg = obj.get("message") or {}
            usage = msg.get("usage") or {}
            if msg.get("model") == "<synthetic>" or obj.get("isSynthetic") is True:
                continue
            identity = msg.get("id") or obj.get("requestId") or obj.get("request_id") or ("unidentified", len(messages))
            key = (obj.get("sessionId") or obj.get("session_id") or "", identity)
            fields = ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
            previous = messages.setdefault(key, dict.fromkeys(fields, 0))
            for k in fields:
                value = usage.get(k)
                if type(value) is int and 0 <= value <= 9007199254740991:
                    previous[k] = max(previous[k], value)
except Exception:
    sys.exit(0)
for usage in messages.values():
    total_input += usage["input_tokens"]
    total_cache_read += usage["cache_read_input_tokens"]
    total_cache_write += usage["cache_creation_input_tokens"]
total_eff = total_input + total_cache_read + total_cache_write
hit = (total_cache_read / total_eff * 100.0) if total_eff > 0 else 100.0
print(f"{hit:.1f} {total_eff}")
PYEOF
)

[ -n "$RESULT" ] || exit 0

HIT_RATE="${RESULT% *}"
TOTAL_EFF="${RESULT##* }"

# Floor check (integer compare on TOTAL_EFF).
case "$TOTAL_EFF" in
  ''|*[!0-9]*) exit 0 ;;
esac
[ "$TOTAL_EFF" -lt "$TOTAL_FLOOR" ] && exit 0

# Compare HIT_RATE (float) to FLOOR_PCT (int) using awk.
BELOW=$(/usr/bin/awk -v h="$HIT_RATE" -v f="$FLOOR_PCT" 'BEGIN { print (h+0 < f+0) ? "1" : "0" }')
[ "$BELOW" = "1" ] || exit 0

# Emit non-blocking reminder to stderr (Stop hook stderr is surfaced to user).
/bin/cat >&2 <<EOF

[stop-hook cache-baseline] Session cache-read token share: ${HIT_RATE}% (floor ${FLOOR_PCT}%, total input ${TOTAL_EFF} tokens).

Likely causes (top 5 anti-patterns):
  1. Dynamic prompt prefix — values change every turn, breaking cache key.
  2. Large-file Read without offset/limit — pulls entire file into context.
  3. Monolithic rule file edited mid-session — invalidates cached system prompt.
  4. Long-running task context — consider a phase boundary or scoped isolation; dispatch itself adds tokens.
  5. Frequent CLAUDE.md / settings edits during session — busts the prefix cache.

Diagnostic guide: ${ANTI_PATTERNS_DOC}
Silence (intentional): export ${SKIP_ENV_NAME}=1

EOF
exit 0
