#!/usr/bin/env bash
#
# CONDUCTOR universal hook template
# hook_id: stop-r6-review-check
# trigger: stop
# action: Remind to run pre-merge code review (Q2) when feature/fix/chore branch
#         has a recently-pushed open PR.
# compile_targets: claude,cursor,copilot,gemini,codex
# fallback: rule-text-reminder
#
# Generated by adapters/<tool>/transform.sh.
#
# Enforces:
#   - quality-gates.md Q2 (pre-merge code review on open PR)
#
# Skip conditions:
#   - current branch is in CONDUCTOR_DIRECT_PUSH_BRANCHES (no PR expected)
#   - no open PR for current branch
#   - no push in last STALE_MINUTES (nothing new to review)
#   - cool-down flag present (review reminder already shown recently)

set -u

DIALECT="${CONDUCTOR_HOOK_DIALECT:-claude}"

# Stop/AfterAgent hooks can force a continuation. Never force another one when
# the runtime tells us this is already the retry pass. Cursor exposes loop_count;
# Claude/Copilot/Gemini/Codex expose a stop-hook-active boolean.
PYTHON_BIN=""
for candidate in "${CONDUCTOR_PYTHON_BIN:-}" python3 python; do
  [ -n "$candidate" ] || continue
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import json,sys; raise SystemExit(0 if sys.version_info[0] == 3 else 1)' >/dev/null 2>&1; then
    PYTHON_BIN="$candidate"
    break
  fi
done
if [ -z "$PYTHON_BIN" ]; then
  printf '%s\n' '[CONDUCTOR hook] Python 3 is unavailable; pre-merge review guard was not evaluated.' >&2
  exit 0
fi
export PAYLOAD_RAW="$(/bin/cat 2>/dev/null || true)"
if [ -n "${PAYLOAD_RAW:-}" ]; then
  REPEAT_STOP="$(DIALECT="$DIALECT" "$PYTHON_BIN" -c '
import json, os
try:
    d = json.loads(os.environ.get("PAYLOAD_RAW", "{}"))
    dialect = os.environ.get("DIALECT", "claude")
    if dialect == "cursor":
        repeated = int(d.get("loop_count", 0) or 0) > 0
        incomplete = d.get("status", "completed") != "completed"
        print("yes" if repeated or incomplete else "no")
    else:
        active = d.get("stop_hook_active", d.get("stopHookActive", False))
        print("yes" if active is True else "no")
except Exception:
    print("yes")
' 2>/dev/null || printf 'yes')"
  [ "$REPEAT_STOP" = "yes" ] && exit 0
fi

# Placeholders filled by adapters/<tool>/transform.sh:
#   ${CONDUCTOR_DIRECT_PUSH_BRANCHES}  — pipe-separated branch list (default: develop|main|release|HEAD)
#   ${CONDUCTOR_STALE_MINUTES}         — recent-push window (default 30)
#   ${CONDUCTOR_COOLDOWN_SECONDS}      — cool-down per PR (default 1800 = 30 min)
#   ${CONDUCTOR_REVIEW_COMMAND}        — slash command or script to run review (default /code-review)

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT" || exit 0

command -v git >/dev/null 2>&1 || exit 0
command -v gh  >/dev/null 2>&1 || exit 0

DIRECT_PUSH="${CONDUCTOR_DIRECT_PUSH_BRANCHES:-develop|main|release|HEAD}"
STALE_MINUTES="${CONDUCTOR_STALE_MINUTES:-30}"
COOLDOWN="${CONDUCTOR_COOLDOWN_SECONDS:-1800}"
REVIEW_COMMAND="${CONDUCTOR_REVIEW_COMMAND:-/code-review}"
case "$COOLDOWN" in
  ''|*[!0-9]*) exit 0 ;;
esac

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
[ -n "$BRANCH" ] || exit 0

# Skip direct-push branches.
if echo "$BRANCH" | /usr/bin/grep -qE "^(${DIRECT_PUSH})$"; then
  exit 0
fi

# Recent-push detection.
THIRTY_MIN_AGO=$(date -v-"${STALE_MINUTES}"M '+%s' 2>/dev/null || date -d "${STALE_MINUTES} minutes ago" '+%s' 2>/dev/null)
[ -n "$THIRTY_MIN_AGO" ] || exit 0

RECENT_PUSH=$(git reflog --date=unix 2>/dev/null \
  | /usr/bin/awk -v t="$THIRTY_MIN_AGO" '
      /push/ {
        stamp=$0
        sub(/^.*\{/, "", stamp)
        sub(/\}.*$/, "", stamp)
        if (stamp ~ /^[0-9]+$/) {
          if (stamp+0 >= t+0) { print; exit }
        }
      }')
[ -n "$RECENT_PUSH" ] || exit 0

# Open PR for current branch.
PR_JSON=$(gh pr list --head "$BRANCH" --state open --json url,number --limit 1 2>/dev/null)
[ -n "$PR_JSON" ] && [ "$PR_JSON" != "[]" ] || exit 0

PR_URL=$(printf '%s' "$PR_JSON" | /usr/bin/sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
PR_NUM=$(printf '%s' "$PR_JSON" | /usr/bin/sed -n 's/.*"number":\([0-9]*\).*/\1/p')
[ -n "$PR_NUM" ] || exit 0

# Cool-down per PR.
FLAG="/tmp/conductor-q2-flag-${USER:-unknown}-${PR_NUM}"
if [ -f "$FLAG" ]; then
  # GNU stat (Linux/Git Bash) accepts -c; BSD stat (macOS) accepts -f.
  # Trying BSD first is unsafe on Git Bash because `stat -f %m` succeeds with
  # a filesystem report beginning with "File:", which is not an epoch value.
  FLAG_MTIME=$(/usr/bin/stat -c %Y "$FLAG" 2>/dev/null || /usr/bin/stat -f %m "$FLAG" 2>/dev/null || printf '0')
  NOW=$(date +%s 2>/dev/null || printf '0')
  case "$FLAG_MTIME" in
    ''|*[!0-9]*) exit 0 ;;
  esac
  case "$NOW" in
    ''|*[!0-9]*) exit 0 ;;
  esac
  FLAG_AGE=$(( NOW - FLAG_MTIME ))
  [ "$FLAG_AGE" -lt "$COOLDOWN" ] && exit 0
fi
touch "$FLAG"

REASON="[stop-hook Q2] Open PR #${PR_NUM} on branch \`${BRANCH}\` with recent push. Confirm the Q1 reviewed snapshot still matches the PR head/base. If identical, inspect only PR-specific evidence; otherwise run \`${REVIEW_COMMAND} ${PR_URL}\` on the unreviewed delta (full review when provenance is missing or unsafe). See universal-rules/quality-gates.md Q2. Docs-only PRs are exempt."

REASON="$REASON" DIALECT="$DIALECT" "$PYTHON_BIN" -c '
import json, os
reason = os.environ.get("REASON", "")
dialect = os.environ.get("DIALECT", "claude")
if dialect == "cursor":
    print(json.dumps({"followup_message": reason}))
elif dialect == "gemini":
    print(json.dumps({"decision": "deny", "reason": reason}))
else:
    print(json.dumps({"decision": "block", "reason": reason}))
'
