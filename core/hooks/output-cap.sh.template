#!/usr/bin/env bash
#
# CONDUCTOR universal hook template
# hook_id: output-cap
# trigger: posttool (Claude) / pretool (Gemini shell-rewrite)
# action: Cap tool-result size written into context (head+tail+marker).
# compile_targets: claude,gemini
# fallback: rule-text-reminder
#
# Generated by adapters/<tool>/transform.sh.
#
# Behavior (fail-open, non-blocking):
#   1. Honor CONDUCTOR_SKIP_OUTPUT_CAP=1 opt-out before any work.
#   2. Read the tool hook payload from stdin. Empty stdin -> nothing to do.
#   3. Pure-bash char/size short-circuit: estimate tokens at ~4 chars/token
#      (${#RAW} counts characters, not bytes, under UTF-8 — the python
#      estimate() below uses the SAME char-count unit so the two stages
#      agree) and skip spawning python3 entirely when the whole raw payload
#      cannot possibly exceed the token budget (perf guard — do this BEFORE
#      python3). This gate only fires on the Claude dialect (RAW *is* the
#      tool output being measured there); the Gemini dialect always falls
#      through to python3 regardless of RAW's size — see step 5.
#   4. Delegate to python3 for JSON parsing + head/tail truncation. The raw
#      payload is piped to python3 over STDIN (not an env var) so it is not
#      subject to the OS argument/environment size limit (ARG_MAX, ~1MB on
#      most platforms) — payloads larger than that would silently pass
#      through untruncated if carried via env var. On the Claude dialect,
#      print an updatedToolOutput hookSpecificOutput payload when the tool
#      result exceeds CONDUCTOR_OUTPUT_CAP_TOKENS; otherwise print nothing
#      (untouched).
#   5. On the Gemini dialect, rewrite a `run_shell_command` tool_input.command
#      to merge stdout+stderr and pipe the combined stream through a
#      byte-capping awk truncator (BeforeTool rewrite —
#      Gemini has no post-hoc tool-output edit surface), unless the command
#      already carries the …[CONDUCTOR] marker (idempotency guard) or the
#      tool is not run_shell_command; otherwise print nothing (untouched).
#   6. ALWAYS exit 0. Any error, missing input, or missing python3 -> allow
#      silently (never fail a tool call because of this guard).
#
# Overrides (runtime env, not compile-time placeholders):
#   CONDUCTOR_SKIP_OUTPUT_CAP=1       disable entirely
#   CONDUCTOR_OUTPUT_CAP_TOKENS       token budget before truncation (default
#                                     12000; non-numeric input is clamped
#                                     back to the default, fail-open)
#   CONDUCTOR_HOOK_DIALECT            claude (default) | gemini

set -u

# Honor opt-out before any work.
[ "${CONDUCTOR_SKIP_OUTPUT_CAP:-}" = "1" ] && exit 0

# Validate the token budget: clamp non-numeric / empty input back to the
# default rather than letting it reach arithmetic (fail-open, same spirit as
# the envint() coercion in pretool-loop-guard.sh.template).
case "${CONDUCTOR_OUTPUT_CAP_TOKENS:-}" in
  ''|*[!0-9]*) LIMIT=12000 ;;
  *) LIMIT="$CONDUCTOR_OUTPUT_CAP_TOKENS" ;;
esac
DIALECT="${CONDUCTOR_HOOK_DIALECT:-claude}"

# Robust JSON handling needs python3; without it, degrade to silent allow.
command -v python3 >/dev/null 2>&1 || exit 0

# Read the tool hook payload from stdin (no piped stdin -> nothing to do).
RAW="$(/bin/cat 2>/dev/null || true)"
[ -n "$RAW" ] || exit 0

# Pure-bash char/size short-circuit: ~4 chars/token floor; skip python entirely
# when the whole payload cannot exceed the token budget. This MUST run before
# spawning python3 — it is the cheap perf guard for the common small-output case.
#
# Allowlist (not denylist): only the Claude dialect's post-hoc byte gate may
# skip python3, since RAW *is* the tool output being measured there. On the
# Gemini dialect RAW is the (always small) BeforeTool payload — just the
# not-yet-run command string — so its size says nothing about how much output
# the command will later produce; short-circuiting there would skip the
# rewrite unconditionally and silently disable the guard. Any future/unknown
# dialect also falls through to python3 rather than being silently skipped —
# python3's own dialect check (default: no-op) fails open safely either way.
if [ "$DIALECT" = "claude" ]; then
  CHARS=${#RAW}
  [ "$CHARS" -lt $((LIMIT * 4)) ] && exit 0
fi

# The python source is captured into a variable (small — just code, never data)
# and passed via `-c`, so it does not hit ARG_MAX either. The actual (possibly
# large) RAW payload is streamed in over stdin, read with sys.stdin.read().
SCRIPT=$(cat <<'PY'
import json, os, sys
raw = sys.stdin.read()
limit = int(os.environ["LIMIT"]); dialect = os.environ["DIALECT"]
try:
    d = json.loads(raw)
except Exception:
    sys.exit(0)

def estimate(s):            # heuristic: ~4 chars/token (documented asymmetry vs Codex)
    return max(1, len(s) // 4)

def clip(text, keep_chars, elided_tokens):
    # head+tail+marker with an explicit char budget (70% head / 30% tail).
    head = int(keep_chars * 0.7); tail = keep_chars - head
    marker = "\n…[CONDUCTOR] output truncated — %d tokens elided; re-run scoped (a filter/range/head) to see more…\n" % elided_tokens
    tail_part = text[-tail:] if tail > 0 else ""
    return text[:head] + marker + tail_part

def truncate(text, limit):
    if estimate(text) <= limit:
        return None
    new = clip(text, limit * 4, estimate(text) - limit)
    # Never-grow guard: for inputs only slightly over the threshold the added
    # marker can exceed the chars removed — leave those untouched.
    if len(new) >= len(text):
        return None
    return new

# Marker length allowance for the leaf-budget arithmetic below: the marker is
# ~97 chars plus the elided-count digits; 110 covers any realistic count.
MARKER_ALLOW = 110
MIN_KEEP = 200               # smallest head+tail we keep per clipped leaf

if dialect == "claude":
    tr = d.get("tool_response", d.get("tool_result", ""))
    # Claude Code validates updatedToolOutput against the TOOL's own output
    # schema and silently discards a replacement that does not match the
    # original response shape (verified against claude.exe 2.1.215:
    # `e.outputSchema?.safeParse(H.updatedToolOutput)` gates the swap and an
    # "does not match <tool>'s output shape" error path keeps the original).
    # So the replacement MUST be shape-preserving: an object/list response is
    # returned as the SAME object with its oversized string leaves clipped in
    # place (e.g. Bash {"stdout": ...} stays an object with a shorter stdout);
    # only a plain-string response may be replaced by a plain string.
    try:
        if isinstance(tr, str):
            new = truncate(tr, limit)
            if new is None:
                sys.exit(0)
            out = new
        elif isinstance(tr, (dict, list)):
            # Single-pass arithmetic (adversarial-review fix): serialize ONCE,
            # compute the total char reduction needed, then distribute it over
            # the largest string leaves — each clip's exact shrink is known up
            # front (take + marker accounting), so there is no per-iteration
            # re-serialization (was O(n^2), 27s on a 1.6MB payload) and a clip
            # can NEVER make a leaf larger than it was (was: +26% growth on
            # many-medium-leaf MCP-style payloads).
            total_chars = len(json.dumps(tr))
            if total_chars // 4 <= limit:
                sys.exit(0)
            need = total_chars - limit * 4        # chars to remove (approx; JSON
                                                  # escaping shares the heuristic
                                                  # spirit of 4 chars/token)
            # Iterative walk (no recursion -> no RecursionError on deep nests).
            leaves = []
            stack = [tr]
            while stack:
                node = stack.pop()
                items = node.items() if isinstance(node, dict) else enumerate(node)
                for k, v in items:
                    if isinstance(v, str):
                        leaves.append((len(v), node, k))
                    elif isinstance(v, (dict, list)):
                        stack.append(v)
            leaves.sort(key=lambda x: -x[0])
            changed = False
            SHORT_MARK = "…[CONDUCTOR truncated]"  # squash marker for medium leaves
            for length, parent, key in leaves:
                if need <= 0:
                    break
                # Max shrink a head+tail clip can contribute while it still
                # SHRINKS: new leaf = (length - take - marker) kept + marker
                #        = length - take chars total.
                # Known minor (review-accepted): the 64-char tier boundary is
                # non-monotonic — a leaf just ABOVE it keeps ~310 chars
                # (informative clip) while one just below squashes to ~30.
                # Both branches strictly shrink and the outer bound holds;
                # accepted as a cosmetic discontinuity, not redesigned.
                max_take = length - MIN_KEEP - MARKER_ALLOW
                if max_take >= 64:
                    take = min(need, max_take)
                    marker_elided = max(1, take // 4)
                    s = parent[key]
                    keep = length - take - len("\n…[CONDUCTOR] output truncated — %d tokens elided; re-run scoped (a filter/range/head) to see more…\n" % marker_elided)
                    parent[key] = clip(s, keep, marker_elided)
                elif length >= len(SHORT_MARK) + 26:
                    # Medium leaf: a full head+tail clip would gain almost
                    # nothing (or grow). Squash to a tiny head + short marker.
                    parent[key] = parent[key][:8] + SHORT_MARK
                else:
                    continue                       # too small to shrink at all
                need -= length - len(parent[key])  # actual shrink achieved
                changed = True
            if not changed:
                sys.exit(0)      # nothing clippable without growth -> untouched
            # Best-effort contract: string CONTENT is bounded, but the JSON
            # STRUCTURE (keys/braces of many items) cannot be elided by a
            # shape-preserving replacement — payloads dominated by structural
            # overhead shrink substantially yet may exceed the nominal token
            # budget. Documented limitation (never grows either way).
            out = tr
        else:
            sys.exit(0)          # numbers/bools/null cannot exceed the budget meaningfully
    except SystemExit:
        raise
    except Exception:
        sys.exit(0)              # fail-open: never block or garble a tool result
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "updatedToolOutput": out}}))
elif dialect == "gemini":
    ti = d.get("tool_input", {}) or {}
    cmd = ti.get("command")
    marker = "…[CONDUCTOR]"
    if d.get("tool_name") != "run_shell_command" or not isinstance(cmd, str) or marker in cmd:
        sys.exit(0)
    # cap_bytes: an awk `length($0)` character count (as `estimate()` above),
    # NOT a guaranteed byte count under a UTF-8 locale — same documented
    # chars-vs-bytes asymmetry as the Claude dialect (see step 3's comment).
    cap_bytes = limit * 4
    # Plain (non-f) string: the awk program has no Python interpolation, so it
    # keeps single braces and is copied verbatim into the shell command. Uses
    # a double-quoted Python string (not single-quoted) purely for Python
    # string-literal convenience: it lets the two literal ' characters that
    # delimit the awk program stay unescaped, instead of needing \' inside a
    # single-quoted Python string.
    #
    # Built from `marker` (not retyped) so the idempotency check above and
    # the printed text can never desync into a double-wrap.
    awk_prog = "'{b+=length($0)+1; if(b<=n) print; else if(!m){print \"" + marker + " output truncated; re-run scoped…\"; m=1}}'"
    # Preserve the original command's exit status: a plain `cmd | awk` pipeline
    # reports awk's status (~always 0), so a FAILING command whose output gets
    # capped would silently look like success to the agent. `set -o pipefail`
    # inside this subshell (bash/zsh, what run_shell_command uses on Unix)
    # makes the pipeline's status the last non-zero stage. Gemini CLI runs
    # run_shell_command via `bash -c` on non-Windows platforms (its confirmed
    # runtime), where pipefail is supported. The `2>/dev/null` is attached ONLY
    # to the `set -o pipefail` command (never to the user's cmd) to silence its
    # message. NOTE: under a strict POSIX sh (e.g. dash) `set -o pipefail` is an
    # illegal option that ABORTS the subshell before cmd runs — it does NOT
    # gracefully fall back — so this rewrite deliberately assumes the bash/zsh
    # execution context Gemini actually uses, not POSIX sh.
    #
    # The inner `(set +o pipefail 2>/dev/null; cmd)` subshell turns pipefail
    # back OFF before running the user's own command. Without this, pipefail
    # would inherit into cmd's OWN internal pipes too (bash subshells inherit
    # options at fork time) and change the semantics of extremely common
    # idioms like `cmd | head` — `yes | head -c N` currently exits 0 (head
    # closes the pipe, yes is SIGPIPE'd but its status is discarded); under
    # inherited pipefail it would newly report 141. Only the ONE pipe we add
    # here (cmd-subshell -> awk) should gain pipefail; cmd's own exit-code
    # semantics must stay exactly as they were before this rewrite existed.
    # Route stderr from the completed command subshell into the same bounded
    # stream. Without this, error-heavy commands bypass the cap entirely.
    # This necessarily merges stdout/stderr, a documented limitation of the
    # pre-execution shell-rewrite fallback.
    ti["command"] = "( set -o pipefail 2>/dev/null; ( set +o pipefail 2>/dev/null; " + cmd + " ) 2>&1 | awk -v n=" + str(cap_bytes) + " " + awk_prog + " )"
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "BeforeTool", "tool_input": ti}}))
PY
)
printf '%s' "$RAW" | LIMIT="$LIMIT" DIALECT="$DIALECT" python3 -c "$SCRIPT"
exit 0
