    "test:output-cap": "bash tools/test-output-cap.sh",
    "test:token-economy-audit": "node tools/test-token-economy-audit.js",
    "test:hookify": "node tools/test-hookify-posttool.js",
    "test:runtime-contract": "node tools/test-runtime-contract.js",
    "test:doc-paths": "bash tools/test-doc-path-policy.sh",
    "test:release-version": "node tools/test-release-version.js"
