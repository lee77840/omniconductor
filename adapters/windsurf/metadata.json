{
  "_comment": "Single source for enumerable adapter facts (ADR-040). CI asserts transform.sh / validator / matrix agree with this file. Update HERE first; docs follow.",
  "tool": "windsurf",
  "display_name": "Windsurf",
  "tier": "T3",
  "outputs": [
    { "path": ".windsurfrules", "kind": "bounded_kernel", "validated": true },
    { "path": ".devin/conductor/rules", "kind": "rule_references", "validated": true },
    { "path": ".devin/conductor/recipes", "kind": "recipe_references", "validated": true },
    { "path": ".devin/rules", "kind": "recipe_pointers", "validated": true },
    { "path": ".windsurf/workflows", "kind": "role_workflows", "validated": true },
    { "path": ".agents/skills", "kind": "skills", "validated": true },
    { "path": "docs/CURRENT_WORK.md", "kind": "docs", "validated": false }
  ],
  "instruction_loading": { "strategy": "bounded-kernel+complete-references", "eager": [".windsurfrules"], "reference_roots": [".devin/conductor/rules", ".devin/conductor/recipes"], "recipe_pointer_root": ".devin/rules", "native_scoping": "all-native-pointers" },
  "reflector_outputs": [
    { "path": ".windsurf/hooks.json", "note": "post_cascade_response_with_transcript trajectory hook config (recipe-gated)" },
    { "path": ".conductor/reflect", "note": "runner + brief + scheduling (recipe-gated)" }
  ],
  "install": { "ala_carte": "per-file" },
  "legacy_paths": [".windsurf/rules"],
  "capabilities": {
    "tool_native": {
      "hooks": "partial-no-session-stop",
      "sub_agents": "internal-only",
      "model_routing": "yes",
      "commands": "yes",
      "glob_scoping": "no",
      "scheduler": "none",
      "skills": "yes"
    },
    "conductor_emitted": {
      "rules": "bounded-kernel+full-references",
      "guard_hooks": "none",
      "reflector_loop": "recipe",
      "role_agents": "workflow-fallback",
      "model_routing": "advisory-adaptive-session",
      "skills": "full",
      "role_capabilities": "instruction-fallback"
    }
  },
  "role_capabilities": {
    "schema_version": 1,
    "native_surface": "workflow instructions",
    "default_policy": "instruction-fallback",
    "enforcement": { "read": "fallback", "search": "fallback", "test": "fallback", "edit-code": "fallback", "edit-docs": "fallback", "shell": "fallback", "delegate": "fallback", "mcp": "fallback" },
    "source": { "url": "https://docs.windsurf.com/windsurf/cascade/workflows", "checked": "2026-08-27" }
  },
  "agent_skills": {
    "schema_version": 1,
    "project_path": ".agents/skills",
    "path_status": "recommended",
    "activation": "automatic-and-explicit-one-active",
    "explicit_invocation": "@skills:plan-change",
    "source": {
      "url": "https://docs.devin.ai/product-guides/skills",
      "checked": "2026-07-27"
    }
  },
  "hook_compiler": {
    "schema_version": 1,
    "config_path": ".windsurf/hooks.json",
    "native_policies": [],
    "fallback_policies": ["commit-current-work", "commit-test-coverage", "review-before-stop"],
    "source": {
      "url": "https://docs.windsurf.com/windsurf/cascade/hooks",
      "checked": "2026-07-27"
    }
  },
  "extension_trust": {
    "schema_version": 1,
    "audit_roots": [".windsurf", ".devin"],
    "native_controls": ["restricted-mode", "plugin-permissions", "mcp-marketplace"],
    "mcp_protocol_2026_07_28": "verification-required",
    "sources": [
      { "url": "https://docs.devin.ai/desktop/changelog", "checked": "2026-08-10" },
      { "url": "https://docs.devin.ai/work-with-devin/mcp", "checked": "2026-08-10" }
    ]
  },
  "skill_proposals": {
    "schema_version": 1,
    "inbox_path": ".conductor/skill-proposals",
    "recipe": "self-improvement",
    "opt_in_skill_path": ".agents/skills/propose-skill/SKILL.md",
    "application": "human-reviewed-separate-change",
    "native_acceleration": "documented",
    "source": { "url": "https://docs.devin.ai/product-guides/skills", "checked": "2026-08-10" }
  },
  "plugin_packaging": {
    "schema_version": 1,
    "mode": "direct-fallback",
    "manifest_path": null,
    "native_components": [],
    "inactive_reference_components": ["universal-rules", "hook-registry"],
    "direct_install_required_for": ["skills", "roles", "rules", "guard-hooks", "reflector", "model-routing", "work-coordination", "reversible-ownership"],
    "source": { "url": "https://docs.devin.ai/desktop/changelog", "checked": "2026-08-10" }
  },
  "runtime_contract": {
    "schema_version": 1,
    "product": {
      "canonical_name": "Devin Desktop",
      "aliases": ["Windsurf"],
      "lifecycle": "renamed",
      "note": "The adapter keeps its stable windsurf identifier while targeting Devin Desktop's preferred .devin rule surface and legacy Windsurf compatibility."
    },
    "version": {
      "args": ["--version"],
      "capability_floors": []
    },
    "auth": {
      "status": "verification-required",
      "modes": ["interactive-account"],
      "note": "Effective CLI and Desktop entitlement must be verified in the adopter environment."
    },
    "policy_gates": ["account-or-organization-policy"],
    "probe": {
      "kind": "headless-model",
      "requires_auth": true,
      "requires_network": true,
      "note": "live-verify uses devin -p; Desktop rule visibility remains a manual smoke test."
    },
    "sources": [
      {
        "label": "Devin Desktop changelog",
        "url": "https://docs.devin.ai/desktop/changelog",
        "checked": "2026-07-27"
      },
      {
        "label": "Devin skills and repository paths",
        "url": "https://docs.devin.ai/product-guides/skills",
        "checked": "2026-07-27"
      }
    ]
  },
  "live_verification": { "status": "verified", "date": "2026-08-21", "cli": "devin 3000.4.25 (7e8e528a)", "note": "Devin for Terminal headless probe listed 5/5 rules + read-CURRENT_WORK-first; Desktop UI smoke remains manual" },
  "headless_cli": { "command": "devin", "invocation": "devin -p" }
}
