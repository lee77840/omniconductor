{
  "_comment": "Single source for enumerable adapter facts (ADR-040). CI asserts transform.sh / validator / matrix agree with this file. Update HERE first; docs follow.",
  "tool": "windsurf",
  "display_name": "Windsurf",
  "tier": "T3",
  "outputs": [
    { "path": ".windsurfrules", "kind": "always_loaded", "validated": true },
    { "path": ".devin/rules", "kind": "rules", "validated": true },
    { "path": ".windsurf/workflows", "kind": "role_workflows", "validated": true },
    { "path": ".agents/skills", "kind": "skills", "validated": true },
    { "path": "docs/CURRENT_WORK.md", "kind": "docs", "validated": false }
  ],
  "reflector_outputs": [
    { "path": ".windsurf/hooks.json", "note": "post_cascade_response_with_transcript trajectory hook config (recipe-gated)" },
    { "path": ".conductor/reflect", "note": "runner + brief + scheduling (recipe-gated)" }
  ],
  "install": { "ala_carte": "per-file" },
  "legacy_paths": [".windsurf/rules"],
  "capabilities": {
    "tool_native": {
      "hooks": "partial-no-session-stop",
      "sub_agents": "internal-only",
      "model_routing": "yes",
      "commands": "yes",
      "glob_scoping": "no",
      "scheduler": "none",
      "skills": "yes"
    },
    "conductor_emitted": {
      "rules": "full",
      "guard_hooks": "none",
      "reflector_loop": "recipe",
      "role_agents": "workflow-fallback",
      "model_routing": "advisory-adaptive-session",
      "skills": "full"
    }
  },
  "agent_skills": {
    "schema_version": 1,
    "project_path": ".agents/skills",
    "path_status": "recommended",
    "activation": "automatic-and-explicit-one-active",
    "explicit_invocation": "@skills:plan-change",
    "source": {
      "url": "https://docs.devin.ai/product-guides/skills",
      "checked": "2026-07-27"
    }
  },
  "hook_compiler": {
    "schema_version": 1,
    "config_path": ".windsurf/hooks.json",
    "native_policies": [],
    "fallback_policies": ["commit-current-work", "commit-test-coverage", "review-before-stop"],
    "source": {
      "url": "https://docs.windsurf.com/windsurf/cascade/hooks",
      "checked": "2026-07-27"
    }
  },
  "runtime_contract": {
    "schema_version": 1,
    "product": {
      "canonical_name": "Devin Desktop",
      "aliases": ["Windsurf"],
      "lifecycle": "renamed",
      "note": "The adapter keeps its stable windsurf identifier while targeting Devin Desktop's preferred .devin rule surface and legacy Windsurf compatibility."
    },
    "version": {
      "args": ["--version"],
      "capability_floors": []
    },
    "auth": {
      "status": "verification-required",
      "modes": ["interactive-account"],
      "note": "Effective CLI and Desktop entitlement must be verified in the adopter environment."
    },
    "policy_gates": ["account-or-organization-policy"],
    "probe": {
      "kind": "headless-model",
      "requires_auth": true,
      "requires_network": true,
      "note": "live-verify uses devin -p; Desktop rule visibility remains a manual smoke test."
    },
    "sources": [
      {
        "label": "Devin Desktop changelog",
        "url": "https://docs.devin.ai/desktop/changelog",
        "checked": "2026-07-27"
      },
      {
        "label": "Devin skills and repository paths",
        "url": "https://docs.devin.ai/product-guides/skills",
        "checked": "2026-07-27"
      }
    ]
  },
  "live_verification": { "status": "pending", "date": null, "cli": null, "note": "not yet run" },
  "headless_cli": { "command": "devin", "invocation": "devin -p" }
}
