{
  "_comment": "Single source for enumerable adapter facts (ADR-040). CI asserts transform.sh / validator / matrix agree with this file. Update HERE first; docs follow.",
  "tool": "cursor",
  "display_name": "Cursor",
  "tier": "T1",
  "outputs": [
    { "path": ".cursor/rules", "kind": "bounded_kernel_and_recipe_pointers", "validated": true },
    { "path": ".cursor/conductor/rules", "kind": "rule_references", "validated": true },
    { "path": ".cursor/conductor/recipes", "kind": "recipe_references", "validated": true },
    { "path": ".cursor/agents", "kind": "agents", "validated": true },
    { "path": ".cursor/hooks", "kind": "hooks", "validated": true },
    { "path": ".cursor/hooks.json", "kind": "config", "validated": true },
    { "path": ".agents/skills", "kind": "skills", "validated": true },
    { "path": "docs/CURRENT_WORK.md", "kind": "docs", "validated": false }
  ],
  "instruction_loading": { "strategy": "bounded-kernel+complete-references", "eager": [".cursor/rules/conductor-kernel.mdc"], "reference_roots": [".cursor/conductor/rules", ".cursor/conductor/recipes"], "recipe_pointer_root": ".cursor/rules", "native_scoping": "globs" },
  "reflector_outputs": [
    { "path": ".cursor/hooks.json", "note": "session-end trajectory hook config (recipe-gated)" },
    { "path": ".conductor/reflect", "note": "runner + brief + scheduling (recipe-gated)" }
  ],
  "install": { "ala_carte": "per-file" },
  "legacy_paths": [".cursorrules"],
  "capabilities": {
    "tool_native": {
      "hooks": "yes",
      "sub_agents": "yes",
      "model_routing": "yes",
      "commands": "yes",
      "glob_scoping": "yes",
      "scheduler": "cloud-only",
      "skills": "yes"
    },
    "conductor_emitted": {
      "rules": "bounded-kernel+full-references",
      "guard_hooks": "review-stop-native",
      "reflector_loop": "recipe",
      "role_agents": "full",
      "model_routing": "saved-tier-native-with-provider-fallback",
      "skills": "full",
      "role_capabilities": "readonly-boundary+fallback"
    }
  },
  "role_capabilities": {
    "schema_version": 1,
    "native_surface": "agent readonly",
    "default_policy": "coarse-boundary",
    "enforcement": { "read": "fallback", "search": "fallback", "test": "fallback", "edit-code": "native-coarse", "edit-docs": "native-coarse", "shell": "native-coarse", "delegate": "fallback", "mcp": "fallback" },
    "source": { "url": "https://prod.cursor.com/docs/subagents", "checked": "2026-08-27" }
  },
  "agent_skills": {
    "schema_version": 1,
    "project_path": ".agents/skills",
    "path_status": "alias",
    "activation": "automatic-and-explicit",
    "explicit_invocation": "/plan-change",
    "source": {
      "url": "https://cursor.com/docs/skills",
      "checked": "2026-07-27"
    }
  },
  "hook_compiler": {
    "schema_version": 1,
    "config_path": ".cursor/hooks.json",
    "native_policies": ["review-before-stop"],
    "fallback_policies": ["commit-current-work", "commit-test-coverage"],
    "source": {
      "url": "https://cursor.com/blog/agent-best-practices",
      "checked": "2026-07-27"
    }
  },
  "extension_trust": {
    "schema_version": 1,
    "audit_roots": [".cursor"],
    "native_controls": ["workspace-trust", "sandbox-network-controls", "plugin-marketplace"],
    "mcp_protocol_2026_07_28": "verification-required",
    "sources": [
      { "url": "https://cursor.com/changelog/2-5", "checked": "2026-08-10" }
    ]
  },
  "skill_proposals": {
    "schema_version": 1,
    "inbox_path": ".conductor/skill-proposals",
    "recipe": "self-improvement",
    "opt_in_skill_path": ".agents/skills/propose-skill/SKILL.md",
    "application": "human-reviewed-separate-change",
    "native_acceleration": "verification-required",
    "source": { "url": "https://cursor.com/docs/skills", "checked": "2026-08-10" }
  },
  "plugin_packaging": {
    "schema_version": 1,
    "mode": "direct-fallback",
    "manifest_path": null,
    "native_components": [],
    "inactive_reference_components": ["universal-rules", "hook-registry"],
    "direct_install_required_for": ["skills", "roles", "rules", "guard-hooks", "reflector", "model-routing", "work-coordination", "reversible-ownership"],
    "source": { "url": "https://cursor.com/changelog/2-5", "checked": "2026-08-10" }
  },
  "runtime_contract": {
    "schema_version": 1,
    "product": {
      "canonical_name": "Cursor",
      "aliases": ["Cursor Agent"],
      "lifecycle": "active",
      "note": "Cursor remains active; cursor-agent is the headless verification surface."
    },
    "version": {
      "args": ["--version"],
      "capability_floors": [
        {
          "capability": "project-hooks",
          "minimum": "1.7.0",
          "when_emitted": ".cursor/hooks.json",
          "basis": "documented",
          "source": "https://cursor.com/changelog/1-7"
        },
        {
          "capability": "stop-followup-message",
          "minimum": "2.4.0",
          "when_emitted": ".cursor/hooks/stop-r6-review-check.sh",
          "basis": "documented",
          "source": "https://cursor.com/changelog/2-4"
        }
      ]
    },
    "auth": {
      "status": "policy-controlled",
      "modes": ["interactive-account"],
      "note": "Provider availability and organization policy remain authoritative for model-backed probes."
    },
    "policy_gates": ["workspace-trust", "plan-or-provider-availability"],
    "probe": {
      "kind": "headless-model",
      "requires_auth": true,
      "requires_network": true,
      "note": "live-verify uses cursor-agent -p only when explicitly invoked."
    },
    "sources": [
      {
        "label": "Cursor hooks changelog",
        "url": "https://cursor.com/changelog/1-7",
        "checked": "2026-07-27"
      },
      {
        "label": "Cursor stop-hook continuation",
        "url": "https://cursor.com/changelog/2-4",
        "checked": "2026-07-27"
      }
    ]
  },
  "live_verification": { "status": "pending", "date": null, "cli": null, "note": "not yet run" },
  "headless_cli": { "command": "cursor-agent", "invocation": "cursor-agent -p" }
}
