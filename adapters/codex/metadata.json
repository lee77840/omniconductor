{
  "_comment": "Single source for enumerable adapter facts (ADR-040). CI asserts transform.sh / validator / matrix agree with this file. Update HERE first; docs follow.",
  "tool": "codex",
  "display_name": "Codex",
  "tier": "T2",
  "outputs": [
    { "path": "AGENTS.md", "kind": "always_loaded", "validated": true },
    { "path": ".codex/conductor/rules", "kind": "rule_references", "validated": true },
    { "path": ".codex/conductor/recipes", "kind": "recipe_references", "validated": true },
    { "path": ".codex/agents", "kind": "agents", "validated": true },
    { "path": ".codex/hooks", "kind": "hooks", "validated": true },
    { "path": ".codex/hooks.json", "kind": "config", "validated": true },
    { "path": ".codex/config.toml", "kind": "config", "validated": true },
    { "path": ".agents/skills", "kind": "skills", "validated": true },
    { "path": "docs/CURRENT_WORK.md", "kind": "docs", "validated": false }
  ],
  "instruction_loading": { "strategy": "bounded-kernel+complete-references", "eager": ["AGENTS.md"], "reference_roots": [".codex/conductor/rules", ".codex/conductor/recipes"], "recipe_pointer_root": null, "native_scoping": "explicit-read" },
  "reflector_outputs": [
    { "path": ".codex/hooks.json", "note": "Stop trajectory hook config (recipe-gated)" },
    { "path": ".conductor/reflect", "note": "runner + brief + scheduling (recipe-gated)" }
  ],
  "install": { "ala_carte": "block" },
  "legacy_paths": [".codex/codex.md"],
  "capabilities": {
    "tool_native": {
      "hooks": "yes",
      "sub_agents": "yes",
      "model_routing": "yes",
      "commands": "yes",
      "glob_scoping": "no",
      "scheduler": "local",
      "skills": "yes"
    },
    "conductor_emitted": {
      "rules": "bounded-kernel+full-references",
      "guard_hooks": "supported-native",
      "reflector_loop": "recipe",
      "role_agents": "full",
      "model_routing": "saved-tier-native+effort",
      "skills": "full",
      "role_capabilities": "sandbox-boundary+fallback"
    }
  },
  "role_capabilities": {
    "schema_version": 1,
    "native_surface": "agent sandbox_mode",
    "default_policy": "coarse-boundary",
    "enforcement": { "read": "fallback", "search": "fallback", "test": "fallback", "edit-code": "native-coarse", "edit-docs": "native-coarse", "shell": "native-coarse", "delegate": "fallback", "mcp": "fallback" },
    "source": { "url": "https://learn.chatgpt.com/docs/config-file/config-reference", "checked": "2026-08-27" }
  },
  "agent_skills": {
    "schema_version": 1,
    "project_path": ".agents/skills",
    "path_status": "native",
    "activation": "automatic-and-explicit",
    "explicit_invocation": "$plan-change",
    "source": {
      "url": "https://developers.openai.com/codex/skills",
      "checked": "2026-07-27"
    }
  },
  "hook_compiler": {
    "schema_version": 1,
    "config_path": ".codex/hooks.json",
    "native_policies": ["commit-current-work", "commit-test-coverage", "review-before-stop"],
    "fallback_policies": [],
    "source": {
      "url": "https://learn.chatgpt.com/docs/hooks",
      "checked": "2026-07-27"
    }
  },
  "extension_trust": {
    "schema_version": 1,
    "audit_roots": [".codex", ".agents/plugins", ".mcp.json"],
    "native_controls": ["project-trust", "plugin-hook-trust", "sandbox-and-approval", "secret-redaction"],
    "mcp_protocol_2026_07_28": "verified",
    "sources": [
      { "url": "https://developers.openai.com/codex/changelog", "checked": "2026-08-10" },
      { "url": "https://developers.openai.com/plugins/build/plugins", "checked": "2026-08-10" }
    ]
  },
  "skill_proposals": {
    "schema_version": 1,
    "inbox_path": ".conductor/skill-proposals",
    "recipe": "self-improvement",
    "opt_in_skill_path": ".agents/skills/propose-skill/SKILL.md",
    "application": "human-reviewed-separate-change",
    "native_acceleration": "documented",
    "source": { "url": "https://learn.chatgpt.com/docs/extend/record-and-replay", "checked": "2026-08-10" }
  },
  "plugin_packaging": {
    "schema_version": 1,
    "mode": "native-partial",
    "manifest_path": ".codex-plugin/plugin.json",
    "native_components": ["skills"],
    "inactive_reference_components": ["universal-rules", "role-agents", "hook-registry"],
    "direct_install_required_for": ["roles", "rules", "guard-hooks", "reflector", "model-routing", "work-coordination", "reversible-ownership"],
    "source": { "url": "https://developers.openai.com/plugins/build/plugins", "checked": "2026-08-10" }
  },
  "runtime_contract": {
    "schema_version": 1,
    "product": {
      "canonical_name": "Codex",
      "aliases": ["Codex CLI"],
      "lifecycle": "active",
      "note": "Codex remains active across CLI, IDE, app, and cloud surfaces."
    },
    "version": {
      "args": ["--version"],
      "capability_floors": []
    },
    "auth": {
      "status": "documented",
      "modes": ["chatgpt-account", "api-key"],
      "note": "The local prompt-input probe does not require a model call; model-backed execution has separate authentication."
    },
    "policy_gates": ["project-trust"],
    "probe": {
      "kind": "local-renderer",
      "requires_auth": false,
      "requires_network": false,
      "note": "live-verify uses codex debug prompt-input with an isolated CODEX_HOME."
    },
    "sources": [
      {
        "label": "Codex customization",
        "url": "https://developers.openai.com/codex/concepts/customization",
        "checked": "2026-07-27"
      }
    ]
  },
  "live_verification": { "status": "verified", "date": "2026-07-13", "cli": "codex-cli 0.144.0", "note": "native prompt-input probe confirmed bounded AGENTS kernel is model-visible; full references remain on demand" },
  "headless_cli": { "command": "codex", "invocation": "codex exec" }
}
