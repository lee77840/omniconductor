{
  "_comment": "Single source for enumerable adapter facts (ADR-040). CI asserts transform.sh / validator / matrix agree with this file. Update HERE first; docs follow.",
  "tool": "gemini",
  "display_name": "Gemini CLI",
  "tier": "T2",
  "outputs": [
    { "path": "GEMINI.md", "kind": "always_loaded", "validated": true },
    { "path": ".gemini/styleguide.md", "kind": "rules", "validated": true },
    { "path": ".gemini/agents", "kind": "agents", "validated": true },
    { "path": ".gemini/hooks", "kind": "hooks", "validated": true },
    { "path": ".gemini/settings.json", "kind": "config", "validated": true },
    { "path": ".agents/skills", "kind": "skills", "validated": true },
    { "path": "docs/CURRENT_WORK.md", "kind": "docs", "validated": false }
  ],
  "reflector_outputs": [
    { "path": ".gemini/settings.json", "note": "adds a SessionEnd trajectory entry composed into the same settings.json the output-cap BeforeTool hook writes (recipe-gated)" },
    { "path": ".conductor/reflect", "note": "runner + brief + scheduling (recipe-gated)" }
  ],
  "install": { "ala_carte": "block" },
  "legacy_paths": [],
  "capabilities": {
    "tool_native": {
      "hooks": "yes",
      "sub_agents": "yes",
      "model_routing": "yes",
      "commands": "yes",
      "glob_scoping": "no",
      "scheduler": "none",
      "skills": "yes"
    },
    "conductor_emitted": {
      "rules": "full",
      "guard_hooks": "output-cap+review-stop-native",
      "reflector_loop": "recipe",
      "role_agents": "full",
      "model_routing": "saved-tier-native",
      "skills": "full"
    }
  },
  "agent_skills": {
    "schema_version": 1,
    "project_path": ".agents/skills",
    "path_status": "alias",
    "activation": "automatic-with-consent",
    "explicit_invocation": "not-documented",
    "source": {
      "url": "https://geminicli.com/docs/cli/using-agent-skills/",
      "checked": "2026-07-27"
    }
  },
  "hook_compiler": {
    "schema_version": 1,
    "config_path": ".gemini/settings.json",
    "native_policies": ["review-before-stop"],
    "fallback_policies": ["commit-current-work", "commit-test-coverage"],
    "source": {
      "url": "https://geminicli.com/docs/hooks/reference/",
      "checked": "2026-07-27"
    }
  },
  "extension_trust": {
    "schema_version": 1,
    "audit_roots": [".gemini", "gemini-extension.json"],
    "native_controls": ["trusted-folders", "extension-environment-declarations", "sandbox"],
    "mcp_protocol_2026_07_28": "verification-required",
    "sources": [
      { "url": "https://geminicli.com/docs/extensions/reference/", "checked": "2026-08-10" },
      { "url": "https://geminicli.com/docs/cli/trusted-folders/", "checked": "2026-08-10" }
    ]
  },
  "skill_proposals": {
    "schema_version": 1,
    "inbox_path": ".conductor/skill-proposals",
    "recipe": "self-improvement",
    "opt_in_skill_path": ".agents/skills/propose-skill/SKILL.md",
    "application": "human-reviewed-separate-change",
    "native_acceleration": "documented",
    "source": { "url": "https://github.com/google-gemini/gemini-cli/blob/main/docs/changelogs/index.md", "checked": "2026-08-10" }
  },
  "plugin_packaging": {
    "schema_version": 1,
    "mode": "native-partial",
    "manifest_path": "gemini-extension.json",
    "native_components": ["context", "skills", "agents"],
    "inactive_reference_components": ["universal-rules", "hook-registry"],
    "direct_install_required_for": ["guard-hooks", "reflector", "model-routing", "work-coordination", "reversible-ownership"],
    "source": { "url": "https://geminicli.com/docs/extensions/reference/", "checked": "2026-08-10" }
  },
  "runtime_contract": {
    "schema_version": 1,
    "product": {
      "canonical_name": "Gemini CLI",
      "aliases": ["Antigravity CLI"],
      "lifecycle": "source-conflict",
      "note": "A June 2026 transition announcement points individual users to Antigravity CLI while the current authentication guide still documents Gemini CLI individual sign-in."
    },
    "version": {
      "args": ["--version"],
      "capability_floors": [
        {
          "capability": "native-hooks",
          "minimum": "0.26.0",
          "when_emitted": ".gemini/settings.json",
          "basis": "documented",
          "source": "https://github.com/google-gemini/gemini-cli/releases/tag/v0.26.0"
        }
      ]
    },
    "auth": {
      "status": "source-conflict",
      "modes": ["individual-google-account", "enterprise-code-assist", "api-key", "vertex-ai"],
      "note": "Do not infer eligibility offline; first-party transition and authentication pages currently conflict."
    },
    "policy_gates": ["workspace-trust", "account-or-project-entitlement"],
    "probe": {
      "kind": "headless-model",
      "requires_auth": true,
      "requires_network": true,
      "note": "live-verify can establish effective access only when explicitly invoked by the adopter."
    },
    "sources": [
      {
        "label": "Gemini CLI individual-account transition",
        "url": "https://github.com/google-gemini/gemini-cli/discussions/28017",
        "checked": "2026-07-27"
      },
      {
        "label": "Gemini CLI authentication guide",
        "url": "https://github.com/google-gemini/gemini-cli/blob/main/docs/get-started/authentication.mdx",
        "checked": "2026-07-27"
      }
    ]
  },
  "live_verification": { "status": "pending", "date": null, "cli": null, "note": "not yet run" },
  "headless_cli": { "command": "gemini", "invocation": "gemini -p" }
}
