{
  "_comment": "Single source for enumerable adapter facts (ADR-040). CI asserts transform.sh / validator / matrix agree with this file. Update HERE first; docs follow.",
  "tool": "claude",
  "display_name": "Claude Code",
  "tier": "T1",
  "outputs": [
    { "path": "CLAUDE.md", "kind": "always_loaded", "validated": false },
    { "path": ".claude/rules", "kind": "rules", "validated": true },
    { "path": ".claude/agents", "kind": "agents", "validated": true },
    { "path": ".claude/skills", "kind": "skills", "validated": true },
    { "path": ".claude/hooks", "kind": "hooks", "validated": false },
    { "path": ".claude/settings.json", "kind": "config", "validated": true },
    { "path": "docs/CURRENT_WORK.md", "kind": "docs", "validated": false }
  ],
  "reflector_outputs": [
    { "path": ".claude/commands", "note": "/reflect command (recipe-gated)" },
    { "path": ".conductor/reflect", "note": "runner + brief + scheduling (recipe-gated)" }
  ],
  "install": { "ala_carte": "per-file" },
  "legacy_paths": [],
  "capabilities": {
    "tool_native": {
      "hooks": "yes",
      "sub_agents": "yes",
      "model_routing": "yes",
      "commands": "yes",
      "glob_scoping": "yes",
      "scheduler": "local",
      "skills": "yes"
    },
    "conductor_emitted": {
      "rules": "full",
      "guard_hooks": "full",
      "reflector_loop": "recipe",
      "role_agents": "full",
      "model_routing": "full",
      "skills": "full"
    }
  },
  "agent_skills": {
    "schema_version": 1,
    "project_path": ".claude/skills",
    "path_status": "native",
    "activation": "automatic-and-explicit",
    "explicit_invocation": "/plan-change",
    "source": {
      "url": "https://platform.claude.com/docs/en/agents-and-tools/agent-skills/overview",
      "checked": "2026-07-27"
    }
  },
  "hook_compiler": {
    "schema_version": 1,
    "config_path": ".claude/settings.json",
    "native_policies": ["commit-current-work", "commit-test-coverage", "review-before-stop"],
    "fallback_policies": [],
    "source": {
      "url": "https://code.claude.com/docs/en/hooks",
      "checked": "2026-08-09"
    }
  },
  "extension_trust": {
    "schema_version": 1,
    "audit_roots": [".mcp.json", ".claude"],
    "native_controls": ["project-trust", "permission-sandbox", "plugin-install-consent"],
    "mcp_protocol_2026_07_28": "verification-required",
    "sources": [
      { "url": "https://code.claude.com/docs/en/mcp", "checked": "2026-08-10" },
      { "url": "https://code.claude.com/docs/en/plugins", "checked": "2026-08-10" }
    ]
  },
  "skill_proposals": {
    "schema_version": 1,
    "inbox_path": ".conductor/skill-proposals",
    "recipe": "self-improvement",
    "opt_in_skill_path": ".claude/skills/propose-skill/SKILL.md",
    "application": "human-reviewed-separate-change",
    "native_acceleration": "manual-fallback",
    "source": { "url": "https://code.claude.com/docs/en/skills", "checked": "2026-08-10" }
  },
  "plugin_packaging": {
    "schema_version": 1,
    "mode": "native-partial",
    "manifest_path": ".claude-plugin/plugin.json",
    "native_components": ["skills", "agents"],
    "inactive_reference_components": ["universal-rules", "hook-registry"],
    "direct_install_required_for": ["rules", "guard-hooks", "reflector", "model-routing", "work-coordination", "reversible-ownership"],
    "source": { "url": "https://code.claude.com/docs/en/plugins", "checked": "2026-08-10" }
  },
  "runtime_contract": {
    "schema_version": 1,
    "product": {
      "canonical_name": "Claude Code",
      "aliases": [],
      "lifecycle": "active",
      "note": "Claude Code remains the active product and CLI name."
    },
    "version": {
      "args": ["--version"],
      "capability_floors": [
        {
          "capability": "posttool-output-rewrite",
          "minimum": "2.1.121",
          "when_emitted": ".claude/hooks/output-cap.sh",
          "basis": "live-verified",
          "source": "https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md"
        }
      ]
    },
    "auth": {
      "status": "documented",
      "modes": ["interactive-account", "api-key"],
      "note": "Authentication is required for model-backed headless prompts; doctor never exercises it."
    },
    "policy_gates": ["project-trust"],
    "probe": {
      "kind": "headless-model",
      "requires_auth": true,
      "requires_network": true,
      "note": "live-verify uses claude -p only when explicitly invoked."
    },
    "sources": [
      {
        "label": "Claude Code changelog",
        "url": "https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md",
        "checked": "2026-08-09"
      },
      {
        "label": "Claude Code tools reference",
        "url": "https://code.claude.com/docs/en/tools-reference",
        "checked": "2026-08-09"
      }
    ]
  },
  "live_verification": { "status": "verified", "date": "2026-07-09", "cli": "2.1.205 (Claude Code)", "note": "headless probe listed 5/5 rules + read-CURRENT_WORK-first" },
  "headless_cli": { "command": "claude", "invocation": "claude -p" }
}
